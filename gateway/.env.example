# Documentation only. Inject secrets through your approved secret manager.
EVERPLAIN_GATEWAY_DATABASE_PATH=var/everplain-gateway.db
EVERPLAIN_GATEWAY_BACKEND_URL=http://127.0.0.1:8297
# Production publisher supplies revision/database path and enforces pilot mode.
# Secure production input uses backend origin https://e.qunxue.xyz.
# EVERPLAIN_GATEWAY_TELEGRAM_ALLOWED_SUBJECT_IDS=["<approved-own-user-id>"]
# EVERPLAIN_GATEWAY_FEISHU_ALLOWED_SUBJECT_IDS=["<approved-own-open-id>"]
# Configure all fields for each platform you enable; empty placeholders cannot start.
# EVERPLAIN_GATEWAY_TELEGRAM_TOKEN=
# EVERPLAIN_GATEWAY_TELEGRAM_WEBHOOK_SECRET=
# EVERPLAIN_GATEWAY_TELEGRAM_BACKEND_SECRET=
# EVERPLAIN_GATEWAY_FEISHU_APP_ID=
# EVERPLAIN_GATEWAY_FEISHU_APP_SECRET=
# EVERPLAIN_GATEWAY_FEISHU_ENCRYPT_KEY=
# EVERPLAIN_GATEWAY_FEISHU_VERIFICATION_TOKEN=
# EVERPLAIN_GATEWAY_FEISHU_TENANT_KEY=
# EVERPLAIN_GATEWAY_FEISHU_BACKEND_SECRET=
