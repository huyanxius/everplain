# Runtime configuration lives in backend/.env.example.
# Copy that file to backend/.env and fill in private credentials locally.
# This root file configures Docker Compose only; never put provider keys here.
EVERPLAIN_IMAGE_TAG=local
EVERPLAIN_ENV_FILE=./backend/.env

# Optional identity-only OAuth. Leave blank to hide the provider entry points.
EVERPLAIN_OAUTH_PUBLIC_ORIGIN=
EVERPLAIN_OAUTH_GOOGLE_CLIENT_ID=
EVERPLAIN_OAUTH_GOOGLE_CLIENT_SECRET=
EVERPLAIN_OAUTH_GITHUB_CLIENT_ID=
EVERPLAIN_OAUTH_GITHUB_CLIENT_SECRET=
