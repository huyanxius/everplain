# Copy to backend/.env; this template contains no working credentials.
# Real production mode. Remove the .env file entirely for deterministic local mock mode.
EVERPLAIN_RUNTIME_MODE=base
EVERPLAIN_RELEASE_REVISION=unreleased
EVERPLAIN_DATABASE_URL=sqlite:///var/everplain.db
EVERPLAIN_RETRIEVAL_INDEX_PATH=var/everplain-retrieval.db

# Required: an OpenAI-compatible chat provider. Choose the model offered by your provider.
EVERPLAIN_MODEL_BASE_URL=
EVERPLAIN_MODEL_NAME=
EVERPLAIN_MODEL_API_KEY=
EVERPLAIN_MODEL_REASONING_EFFORT=high
EVERPLAIN_MODEL_TIMEOUT_SECONDS=120
EVERPLAIN_MODEL_PROBE_INTERVAL_SECONDS=300

# Optional verified upstream capacities. Keys bind the exact URL, protocol and
# model; never copy another provider's same-name model limits. The current Qiniu
# deepseek/deepseek-v4.1-flash Chat route has a verified built-in 1M/384K snapshot.
# Other routes can be registered with their actual provider evidence:
# EVERPLAIN_AGENT_MODEL_CAPACITIES={"https://your-provider.example/v1|responses|your-model":{"context_window_tokens":160000,"max_output_tokens":64000,"output_token_parameter":"max_output_tokens","source":"https://your-provider.example/docs/your-model"}}
# MODEL_MAX_INPUT_TOKENS / MODEL_MAX_OUTPUT_TOKENS apply only to structured
# business calls, never Agent conversation answers.

# Required for full semantic retrieval; these are the currently supported models.
EVERPLAIN_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EVERPLAIN_EMBEDDING_MODEL=Pro/BAAI/bge-m3
EVERPLAIN_EMBEDDING_API_KEY=
EVERPLAIN_RERANKER_BASE_URL=https://api.siliconflow.cn/v1
EVERPLAIN_RERANKER_MODEL=Pro/BAAI/bge-reranker-v2-m3
EVERPLAIN_RERANKER_API_KEY=

# Required for web research. The Tavily default needs only a key.
EVERPLAIN_WEB_SEARCH_PROVIDER=tavily
EVERPLAIN_WEB_SEARCH_PROFILE=generic
EVERPLAIN_WEB_SEARCH_API_KEY=

# Required for production. Replace with the actual HTTPS browser origin before starting.
EVERPLAIN_SESSION_COOKIE_NAME=everplain_session
EVERPLAIN_SESSION_COOKIE_SECURE=true
EVERPLAIN_CORS_ALLOWED_ORIGINS=["https://your-domain.example"]
EVERPLAIN_ACCOUNT_INITIAL_ADMIN_EMAIL=
EVERPLAIN_ACCOUNT_INITIAL_ADMIN_PASSWORD=

# Defaults: 20 MiB per file, 500 MiB per user, 10 libraries, 100 documents per library.
EVERPLAIN_MAX_FILE_BYTES=20971520
EVERPLAIN_MAX_STORAGE_BYTES=524288000
EVERPLAIN_MAX_LIBRARIES=10
EVERPLAIN_MAX_DOCUMENTS_PER_LIBRARY=100

# Optional email: required for public email-code registration.
# Configure both and verify the sender's domain with Resend before enabling signup.
# EVERPLAIN_RESEND_API_KEY=
# EVERPLAIN_EMAIL_FROM=Everplain <hello@your-verified-domain.example>

# Optional audio/video transcription: configure all three together.
# EVERPLAIN_TRANSCRIPTION_BASE_URL=
# EVERPLAIN_TRANSCRIPTION_MODEL=
# EVERPLAIN_TRANSCRIPTION_API_KEY=

# Optional identity-only OAuth. Leave blank to hide the provider entry points.
EVERPLAIN_OAUTH_PUBLIC_ORIGIN=
EVERPLAIN_OAUTH_GOOGLE_CLIENT_ID=
EVERPLAIN_OAUTH_GOOGLE_CLIENT_SECRET=
EVERPLAIN_OAUTH_GITHUB_CLIENT_ID=
EVERPLAIN_OAUTH_GITHUB_CLIENT_SECRET=
